<resources>
    <style name="TaskSyncCalendarWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#B8B8B8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="TaskSyncCalendarDayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="TaskSyncCalendarDayNumber">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/widget_calendar_day_normal</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#F3F3F3</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="TaskSyncCalendarDayDot">
        <item name="android:layout_width">5dp</item>
        <item name="android:layout_height">5dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/widget_calendar_dot</item>
        <item name="android:visibility">invisible</item>
    </style>
    <style name="TaskSyncCalendarAgendaRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>
    <style name="TaskSyncCalendarAgendaTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#171717</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="TaskSyncCalendarAgendaTime">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#858585</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TaskSyncCalendarAgendaChevron">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:text">›</item>
        <item name="android:textColor">#A4A4A4</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TaskSyncCalendarDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">#E8E8E8</item>
    </style>
</resources>
